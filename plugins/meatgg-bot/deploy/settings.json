{
  "enabledMcpjsonServers": ["meatgg"],
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Bash",
      "Write",
      "Edit(/**)",
      "Read(/.state/**)",
      "Read(//etc/shadow)",
      "Read(//etc/sudoers*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(~/.netrc)",
      "Read(~/.claude.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/credentials*)",
      "Read(**/secrets*)",
      "mcp__meatgg__reopen_ticket",
      "mcp__meatgg__grant_drop",
      "mcp__meatgg__search_audit_logs",
      "mcp__meatgg__get_transactions",
      "mcp__meatgg__list_game_reports"
    ],
    "allow": [
      "mcp__meatgg__*",
      "mcp__plugin_meatgg-bot_meatgg-bot__get_channel_status",
      "WebFetch",
      "WebSearch"
    ]
  }
}
